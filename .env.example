# Copy to .env.local and fill in. Never commit .env.local.

# Site identity — used in sitemap, feeds, OG metadata.
# In Vercel, set per-environment. VERCEL_URL (auto-set on preview
# deploys) is used as a fallback when NEXT_PUBLIC_SITE_URL is empty.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GITHUB_REPO=

# Anthropic — required for the daily article pipeline (cron + scripts).
# The static site does not call the API at runtime.
ANTHROPIC_API_KEY=

# Image provider selector. One of: fal | none
# `none` writes a flat placeholder; use this when scaffolding or in
# environments without an image-gen budget.
IMAGE_PROVIDER=none

# Required only when IMAGE_PROVIDER=fal.
FAL_KEY=

# /health page — optional, makes GitHub Actions stats render on the site.
# Inside Actions, GITHUB_REPOSITORY and GITHUB_TOKEN are set automatically.
AIFIRST_REPO=
GITHUB_TOKEN=
