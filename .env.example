# Copy to .env.local and fill in. Never commit .env.local.

# Site identity — used in sitemap, feeds, OG metadata.
# In Vercel, set per-environment. VERCEL_URL (auto-set on preview
# deploys) is used as a fallback when NEXT_PUBLIC_SITE_URL is empty.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GITHUB_REPO=

# Anthropic — required for the daily article pipeline (cron + scripts).
# The static site does not call the API at runtime.
ANTHROPIC_API_KEY=

# Gate for the internal /promotion console (IG / Threads captions). The route
# returns 404 when unset and requires ?key=<this value> when configured.
PROMOTION_TOKEN=

# Optional extra Anthropic promotion pass. Static distribution packs are
# generated without this call; leave false to avoid extra spend.
GENERATE_PROMOTION=false

# Image provider selector. One of: fal | nasa | picsum | none
#   fal    — FLUX generation (paid; needs FAL_KEY)
#   nasa   — NASA Astronomy Picture of the Day (keyless; DEMO_KEY by default)
#   picsum — Lorem Picsum keyless stock photo, deterministic per article
#   none   — no generated image (the static layout falls back gracefully)
IMAGE_PROVIDER=none

# Required only when IMAGE_PROVIDER=fal.
FAL_KEY=

# Optional, only when IMAGE_PROVIDER=nasa. Defaults to DEMO_KEY (30 req/hr,
# 50/day — enough for a once-daily job). Free key at https://api.nasa.gov.
NASA_API_KEY=

# --- Optional scraping-source API keys (daily pipeline only) ------------
# Each corresponding source in sources.yml skips itself automatically when its
# key is unset, so these are all optional. Free tiers are ample for a
# once-daily run. The static site never uses these at runtime.
#   The Guardian Open Platform — https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=
#   NYT Article Search — https://developer.nytimes.com/ (500 req/day)
NYTIMES_API_KEY=
#   GNews — https://gnews.io/ (100 req/day, 10 results/search)
GNEWS_API_KEY=
#   StackExchange app key — https://stackapps.com/apps/oauth/register
#   Optional but recommended: the anonymous API returns HTTP 403 from cloud/CI
#   IPs, so without a key the stackexchange source yields nothing in Actions.
STACKEXCHANGE_KEY=

# Optional article extraction fallback used only when direct HTML extraction
# fails. The pipeline skips it when no key is present.
FIRECRAWL_API_KEY=

# Jina embeddings — optional. Powers semantic "related issues" (pnpm
# embed:refresh, run in the daily pipeline). Without it, related issues fall
# back to tag overlap. Free key (1M tokens) at https://jina.ai/embeddings.
JINA_API_KEY=

# /health page — optional, makes GitHub Actions stats render on the site.
# Inside Actions, GITHUB_REPOSITORY and GITHUB_TOKEN are set automatically.
# GITHUB_TOKEN is also used (optionally) by the github-ai-releases source to
# raise its rate limit from 60 to 5000 req/hr.
AIFIRST_REPO=
GITHUB_TOKEN=

# Optional OwnDashboard telemetry callback. Scheduled publishing never depends
# on these values; failures leave the private run-report artifact intact.
OWNDASHBOARD_RUN_REPORT_URL=
OWNDASHBOARD_RUN_REPORT_TOKEN=

# Workflow/script controls. GitHub Actions populates these from validated
# workflow_dispatch inputs; local runs normally use their defaults.
ISSUE_DATE=
ISSUE_LANGUAGE=en
PUBLISH_MODE=auto
MODEL_PROFILE=standard
FORCE_GENERATION=false
SKIP_EMBEDDINGS=true
