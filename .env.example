# Copy to .env.local and fill in. Never commit .env.local.

# Site identity — used in sitemap, feeds, metadata and existing share packs.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GITHUB_REPO=

# Optional manual semantic-related refresh. Without it, related issues fall
# back to tag overlap.
JINA_API_KEY=

# Optional build-time workflow history for /health. Keep the token read-only.
AIFIRST_REPO=
GITHUB_TOKEN=
