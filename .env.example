# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic — required for the daily article pipeline.
ANTHROPIC_API_KEY=

# Image provider selector. One of: fal | none
# (Use `none` during scaffolding / local dev — it writes a placeholder
# image instead of calling a paid API.)
IMAGE_PROVIDER=none

# Required only when IMAGE_PROVIDER=fal.
FAL_KEY=
