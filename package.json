{
  "name": "aifirst",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:content": "tsx scripts/check-content.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:content && pnpm build && pnpm check:bundle",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "generate:daily": "tsx scripts/generate-daily.ts",
    "consume:edition": "tsx scripts/consume-edition-package.ts",
    "generate:weekly": "tsx scripts/generate-weekly.ts",
    "regeneration:check": "tsx scripts/check-regeneration-budget.ts",
    "generate:artifacts": "tsx scripts/generate-static-artifacts.ts",
    "scrape:dry": "tsx scripts/scrape-dry.ts",
    "scrape:og": "tsx scripts/scrape-og-images.ts",
    "pulse:refresh": "tsx scripts/refresh-pulse.ts",
    "embed:refresh": "tsx scripts/embed-articles.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cheerio": "^1.0.0",
    "gray-matter": "^4.0.3",
    "next": "^15.0.0",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.33.5",
    "undici": "^6.20.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.17.1",
    "eslint": "^9.13.0",
    "eslint-config-next": "^15.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "esbuild@<0.25.0": ">=0.25.0",
      "vite@<=6.4.1": ">=6.4.2"
    }
  }
}
