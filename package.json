{
  "name": "aifirst",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:content": "tsx scripts/check-content.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:content && pnpm build",
    "generate:daily": "tsx scripts/generate-daily.ts",
    "generate:weekly": "tsx scripts/generate-weekly.ts",
    "scrape:dry": "tsx scripts/scrape-dry.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "cheerio": "^1.0.0",
    "gray-matter": "^4.0.3",
    "next": "^15.0.0",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.33.5",
    "undici": "^6.20.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.13.0",
    "eslint-config-next": "^15.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["sharp", "esbuild", "unrs-resolver"]
  }
}
